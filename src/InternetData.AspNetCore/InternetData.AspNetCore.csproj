<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The compatibility floor, matching the base SDK: a net8.0 library loads on every later
         runtime, and ASP.NET Core's own support line starts here. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InternetData.AspNetCore</RootNamespace>
    <AssemblyName>InternetData.AspNetCore</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>InternetData.AspNetCore</PackageId>
    <Version>1.0.4</Version>
    <Authors>Mslm Dev</Authors>
    <Company>Mslm Dev</Company>
    <Product>InternetData</Product>
    <Description>The official ASP.NET Core middleware for the InternetData API. Looks up the visitor behind each request - where they are, which network they come from, and whether it is a VPN, a proxy, Tor or a hosting server - and puts the answer on HttpContext. Blocking by country, network type or anonymity is opt-in.</Description>
    <PackageTags>ip;geolocation;asn;vpn;proxy;aspnetcore;middleware;internetdata</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://internetdata.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/internetdata/sdk-dotnet-aspnetcore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Source Link writes the BUILD MACHINE's absolute paths into the symbol package, so a package
       built anywhere but a runner would publish whatever directory tree it was built in. This maps
       them to /_/ and makes the artifact reproducible at the same time. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- A FrameworkReference, not a PackageReference: ASP.NET Core ships with the runtime, so
       depending on the package would pull a second, pinned copy into every consuming app. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="InternetData" Version="2.15.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
